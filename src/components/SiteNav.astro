---
const links = [
  { href: '/words', label: 'Words' },
  { href: '/images', label: 'Images' },
  { href: '/sounds', label: 'Sounds' },
];
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="px-4 pt-7 text-center">
  <nav
    aria-label="Main"
    class="flex flex-wrap justify-center gap-x-[0.4em] text-[clamp(20px,3.4vw,38px)] font-extrabold uppercase tracking-[0.02em]"
  >
    <a href="/words" class="text-mute transition-colors hover:text-soft">
      <span class="normal-case">d</span>ƎEP
    </a>
    {
      links.map(({ href, label }) => (
        <span class="contents">
          <span aria-hidden="true" class="text-mute">/</span>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[isActive(href) ? 'text-ink' : 'text-mute transition-colors hover:text-soft']}
          >
            {label}
          </a>
        </span>
      ))
    }
  </nav>
</header>
